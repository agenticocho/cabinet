# Runtime noise
.agents/tmpcabinet-*.log
.cabinet-state/runtime-ports.json
*.db-shm
*.db-wal

# Optionally ignore conversation history (it grows fast)
.agents/.conversations/

# Optionally ignore stats (changes every heartbeat)
# .agents/.memory/*/stats.json
# .agents/*/memory/stats.json

# Runtime state — never track
.agents/.slack/
.agents/.history/
.agents/.memory/
.agents/.runtime/
.agents/*/sessions/
.global-agents/.history/
.global-agents/.memory/
.cabinet-state/
.next/
